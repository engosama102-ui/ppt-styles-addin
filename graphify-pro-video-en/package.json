{
  "name": "graphify-pro-video-en",
  "version": "1.0.0",
  "private": true,
  "description": "Graphify Pro: 90-second vertical English promotional video built with Remotion",
  "scripts": {
    "start": "remotion studio",
    "render": "remotion render src/index.ts GraphifyProAd out/graphify-pro-ad-en.mp4",
    "render:audio": "python scripts/generate_voiceover.py",
    "render:sfx": "python scripts/generate_sound.py",
    "still": "remotion still src/index.ts GraphifyProAd out/still.png",
    "typecheck": "tsc --noEmit",
    "build:final": "npm run render && npm run finalize",
    "finalize": "python scripts/finalize.py"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
